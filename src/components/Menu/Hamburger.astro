---
import { Icon } from "astro-icon/components";

const items = [['Blog','/posts'], ['A Propos','/apropos']];

---

<astro-hamburgerbestmenu class='block xl:hidden pt-[16px] '>        

    <label class="menu__btn" for="menu__toggle">
      <span class="after:bg-blog-marron-fond before:bg-blog-marron-fond bg-blog-marron-fond"></span>
    </label>

    <ul class="menu__box  bg-transparent  before:absolute before:top-0 before:left-0 before:h-full  before:w-full before:bg-blog-black gap-8 text-lg uppercase flex flex-col items-center justify-center">
      {items.map((item) => (
        <a href={item[1]} class="z-10"><li>{item[0]}</li></a>
    ))}
    <a  href='https://github.com/bot-35'><button class='btn--two-colors--bl-tr flex flex-col  items-center'>    <Icon name="octicon:logo-github-24" class='h-6 cursor'/></button></a>

  </ul>

</astro-hamburgerbestmenu>



<style is:global>
#menu__toggle {
opacity: 0;
position:absolute;
top:0;
left:0;
}
#menu__toggle:checked ~  astro-hamburgerbestmenu > .menu__btn > span {
transform: rotate(45deg);
}
#menu__toggle:checked ~  astro-hamburgerbestmenu > .menu__btn > span::before {
top: 0;
transform: rotate(0deg);
}
#menu__toggle:checked ~  astro-hamburgerbestmenu > .menu__btn > span::after {
top: 0;
transform: rotate(90deg);
}
#menu__toggle:checked ~ astro-hamburgerbestmenu > .menu__box {
right: 0 !important;
top: 0 !important;

}
#menu__toggle:checked ~ astro-hamburgerbestmenu > .menu__box > li > .menu__item {
opacity: 1;
}

.menu__btn {
position: relative;
display: block;
width: 26px;
height: 26px;
cursor: pointer;
z-index: 1;

}
.menu__btn > span,
.menu__btn > span::before,
.menu__btn > span::after {
display: block;
position: absolute;

width: 100%;
height: 4px;
border-radius: 9px;
transition-duration: .25s;
}
.menu__btn > span::before {
content: '';
top: -9px;
}
.menu__btn > span::after {
content: '';
top: 9px;
}
.menu__box {
position: fixed;
top: -150%;
right: 0%;
margin: 0;
width: 100%;
height: 100vh;
text-align: center;
list-style: none;
box-shadow: 2px 2px 6px rgba(0, 0, 0, .4);
transition-duration: 1s;
overflow-y: hidden;
}
.menu__item {
display: inline-block;
padding: 12px 24px;
opacity: 0;
color: #333;
font-size: 20px;
font-weight: 600;
text-decoration: none;
transition-duration: .25s;
height: 36px;
padding-block-start: 13px;
letter-spacing: 0.12rem;
text-transform: capitalize;
}
.menu__item:hover {
letter-spacing: 0.1rem;

}
</style>