---
import { Code } from 'astro:components';

const { code, theme = 'rose-pine', lang, header } = Astro.props;
---

    <Code code={code} theme={theme} lang={lang} inline  />

<style is:global>
    @reference "tailwindcss/utilities.css";
@reference "tailwindcss/theme.css";
    .codebox > pre > code > span > span {
        @apply text-xs xl:text-base;
    }
</style>

