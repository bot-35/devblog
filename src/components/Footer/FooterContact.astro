---
const sentences = ['Une question ?', 'Une suggestion ?', 'N\'hésitez pas !']

---
<div class='relative flex flex-col w-full items-center gap-16'>
        {sentences.map((sentence) => (
            <div class='relative ' >
                <p class=' text-3xl xl:text-5xl     '>{sentence}</p> 
            </div>
            ))}
            <div class='flex flex-row  items-center w-full justify-center gap-8     '>
                <svg class="h-12 w-12 fill-blog-marron-text" xmlns="http://www.w3.org/2000/svg">
                    <use  href="#mail"/>
                </svg>
                <p>contact@maximebourdon.fr</p>
            </div>
            <!--<div class='flex flex-row items-center w-full justify-center gap-8     '> 
                <svg class="h-12 w-12 fill-blog-marron-text" xmlns="http://www.w3.org/2000/svg">
                    <use  href="#tel"/>
                </svg>
                <p>00 00 00 00 00</p>
            </div>-->
</div>

