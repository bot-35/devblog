    {items.map((item) => (
        <a class='      '  href={item[1]}><p class='uppercase hover-underline-animation text-blog-marron-reflet hover:text-blog-marron-text  before:inline-block before:h-[5px] hover:before:bg-red-800 before:w-[5px] before:mr-[8px]  before:bg-blog-marron-fond'>{item[0]}</p></a>
    ))}
</section>


