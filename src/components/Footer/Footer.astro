---
import FooterBottom from "./FooterBottom.astro";
import FooterGeek from "./FooterGeek.astro";
import FooterGitHub from "./FooterGitHub.astro"
import FooterMenu from "./FooterMenu.astro";
import bg from "../../img/photo-bg/sable.jpg";
import profil2 from '../../img/profil/bot-35-travel.png';
import LastMusic from "../LastMusic/LastMusic.astro";

---


<footer class=' pt-32 relative  overflow-hidden'>
  <div class='absolute top-0 left-0 h-2 w-full bg-gradient-to-tr origin-left from-blog-marron-fond via-blog-marron-text to-blog-marron-reflet ' 
  id="footerBorder"   
   /> 
  <div class='absolute bg-center bg-cover h-full bottom-0 left-0  w-full opacity-100 -z-20  bg-gradient-to-b from-blog-black from-30%'/>
  <div style=`background-image: url("${bg.src}")` class=" absolute bg-center bg-cover bottom-0 left-0  h-full w-full  -z-30 -hue-rotate-180"/>
  <div  id="bgContactFooter" style=`background-image: url("${profil2.src}")` class="  absolute bg-right-top bg-no-repeat bg-contain top-0   opacity-100 -rotate-[9deg] origin-bottom-right     left-48 xl:left-24  -z-20   h-1/4 xl:h-2/4 w-full   "/>

  <section class='w-full xl:w-10/12 xl:mx-[9%] flex flex-col gap-16 z-10'>
    <FooterGeek/>
    <div class='flex flex-col  xl:flex-row  xl:justify-around justify-center items-center gap-8'>
          <LastMusic  limit="1"/>
          <FooterGitHub/>
    </div>
    <FooterMenu/>
    <FooterBottom/>

  </section>
</footer>