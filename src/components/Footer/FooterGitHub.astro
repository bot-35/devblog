---
import { getGithubStats } from "../../lib/github/github";
const GH_LOGIN = "bot-35";
const stats = await getGithubStats(GH_LOGIN, "devblog");
---

<section class="rounded-2xl p-6 bg-blog-marron-fond/10 shadow-sm">
  <h3 class="text-xl font-bold uppercase tracking-wider">GitHub</h3>
  <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-4">
    <div><p class="text-sm opacity-70">Followers</p><p class="text-3xl font-extrabold">{stats.followers}</p></div>
    <div><p class="text-sm opacity-70">Repos publics</p><p class="text-3xl font-extrabold">{stats.publicRepos}</p></div>
    <div><p class="text-sm opacity-70">Étoiles</p><p class="text-3xl font-extrabold">{stats.totalStars}</p></div>
    <div><p class="text-sm opacity-70">Commits (12 mois)</p><p class="text-3xl font-extrabold">{stats.commitsLast12Months}</p></div>
  </div>

  <div class="mt-6">
    <p class="text-sm opacity-70">devblog — commits (branche par défaut)</p>
    <p class="text-2xl font-bold">{stats.devblog.totalCommitsDefaultBranch}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {stats.devblog.languages.map((l) => (
        <li class="px-3 py-1 rounded-full border text-sm" style={`border-color:${l.color ?? 'currentColor'}`}>
          {l.name} · {l.share}%
        </li>
      ))}
    </ul>
  </div>
</section>
