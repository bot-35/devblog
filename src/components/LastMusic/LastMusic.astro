---
import dancing from "../../img/profil/dance.png";
import dancing1 from "../../img/profil/9675a999-06d8-4d59-8d94-091fbde04083.png";
import dancing2 from "../../img/profil/91188050-9037-45ca-a595-cd41ccfa8ff7.png";
import dancing3 from "../../img/profil/ee7db05e-f567-42cf-8301-f9e6ba45c8ea.png";

import { Icon } from 'astro-icon/components';

/**
 * Usage : <LastFmClient limit={5} />
 */
const { limit = 1 } = Astro.props;
---

<section class="w-full rounded-4xl max-w-md h-48 flex flex-row border border-blog-marron-text/25 bg-blog-marron-fond/25 backdrop-blur-sm" aria-labelledby="lastfm-title">
    <h3 id="lastfm-title" class="text-sm rounded-4xl text-center uppercase [writing-mode:vertical-rl] [text-orientation:mixed] bg-gradient-to-r origin-left from-blog-marron-shadow/50  font-jost  to-blog-marron-text/75 border-r border-blog-black/15 py-4 px-4 text-blog-black ">
        <img src={dancing.src} alt='Bot-35 qui danse' class=" h-full w-fit -rotate-12"/>
    </h3>
    <section class="h-32 flex flex-row items-center justify-center relative p-8">
        <astro-lastmusic class="block" data-limit={limit}>
            <div class=" mt-16 rounded-4xl text-sm bg-blog-marron-reflet/10 border border-blog-marron-text shadow-2xl shadow-blog-black/25  h-32 flex flex-row items-center justify-center gap-0 text-blog-black" data-role="container">
                Chargement…
            </div>
        </astro-lastmusic>
    </section>
</section>

    <script type="module">
        class AstroLastMusic extends HTMLElement {
            connectedCallback() {
                const container = this.querySelector('[data-role="container"]');
                const LIMIT = Number(this.dataset.limit || 5);

                function timeAgo(ts) {
                    if (!ts) return "";
                    const diff = Date.now() - ts;
                    const mins = Math.floor(diff / 60000);
                    if (mins < 1) return "à l’instant";
                    if (mins < 60) return `il y a ${mins} min`;
                    const h = Math.floor(mins / 60);
                    return `il y a ${h} h`;
                }

                const load = async () => {
                    try {
                        const res = await fetch("/api/lastfm.json", {
                            cache: "no-store",
                        });
                        if (!res.ok) throw new Error("HTTP " + res.status);
                        const data = await res.json();

                        const updatedLabel = data?.updatedAtTs
                            ? timeAgo(data.updatedAtTs)
                            : "";
                        const tracks = (data?.tracks ?? []).slice(0, LIMIT);

                        if (!tracks.length) {
                            container.textContent =
                                "Aucune donnée disponible pour le moment.";
                            return;
                        }

                        const list = document.createElement("ul");
                        list.className = "space-y-3";

                        for (const t of tracks) {
                            const li = document.createElement("li");
                            li.className = "flex flex-col items-center gap-3";

                            if (t.image) {
                                const img = document.createElement("img");
                                img.src = t.image;
                                img.alt = "";
                                img.width = 48;
                                img.height = 48;
                                img.loading = "lazy";
                                img.className = "rounded-lg";
                                li.appendChild(img);
                            }

                            const a = document.createElement("a");
                            a.href = t.url || "#";
                            a.textContent = t.title || "Sans titre";
                            a.className = "font-medium text-xl text-blog-marron-text hover:text-blog-marron-shadow tracking-widest";
                            a.rel = "noopener";
                            a.target = "_blank";

                            const by = document.createElement("span");
                            by.className = "text-center text-xs text-blog-marron-reflet tracking-wider leading-loose";
                            by.textContent = " — " + (t.artist || "Inconnu");

                            li.appendChild(a);
                            li.appendChild(by);

             

                            list.appendChild(li);
                        }

                        container.innerHTML = "";
                        container.appendChild(list);

                    } catch (e) {
                        console.error(e);
                        container.textContent =
                            "Impossible de charger les écoutes Last.fm pour le moment.";
                    }
                };

                load();
            }
        }

        // 🔑 Enregistrer le custom element
        if (!customElements.get("astro-lastmusic")) {
            customElements.define("astro-lastmusic", AstroLastMusic);
        }
    </script>
</section>
