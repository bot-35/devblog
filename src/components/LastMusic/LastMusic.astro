---
/* ASSETS  IMPORT */
import "@fontsource-variable/jetbrains-mono";
import robot from "../../img/profil/vinyl2.png";
import Ondes from "./onde.svg";

/* DATA */
const { limit = 1 } = Astro.props;
---

<section
  class="relative ml-32 isolate w-full max-w-2xl overflow-hidden rounded-md border border-blog-marron-text/25
         bg-gradient-to-tl origin-left from-blog-marron-fond via-blog-marron-text to-blog-marron-reflet px-5 py-4
         shadow-xl shadow-blog-black/50"
  aria-labelledby="lfm-title"
  style="font-family: 'JetBrains Mono Variable', monospace;"
>
  <!-- TODO : Remplacer full tailwind inline par classe utilitaire (REFACTOR GLOBAL) -->
  <!-- Overlay  pour teinter le composant-->
  <div class="absolute bg-blog-marron-reflet/25 top-0 left-0 h-full w-full"/>
  
  <div
    class="absolute right-2 font-black text-[14px] uppercase text-blog-marron-reflet italic rotate-12 z-50
        before:absolute before:top-[-30%] before:left-[-250%] before:w-[500%] before:h-[150%] before:bg-blog-black/25 before:-z-10 before:border-2 before:border-blog-marron-fond"
  >
    <span>DERNIÈRE ÉCOUTE</span>
  </div>

  <!-- SVG -- Motif ondes -->
  <Ondes class="absolute inset-0 -z-10 opacity-60" />

  <div class="flex items-end gap-6">
    <!-- Vignette robot -->
    <div
      class="shrink-0 relative rounded-full brightness-10"
      id="lastmusic_vinyl"
    >
      <img
        src={robot.src}
        alt="Bot-35 qui écoute de la musique"
        class="h-46 w-46 object-cover border-8 border-blog-marron-text/15 rounded-full"
        loading="lazy"
      />
      <!-- léger bord clair façon cadre -->
      <span
        class="pointer-events-none absolute inset-0 rounded-full ring-4 ring-blog-black/5"
      ></span>
    </div>

    <!-- Bloc texte -->
    <astro-lastmusic class="block min-w-0 flex-1 px-8" data-limit={limit}>
      <div class="relative min-w-0 flex flex-col">
        <!-- Légende en haut-droit -->

        <!-- Titre (remplacé dynamiquement) -->
        <h3
          id="lfm-title"
          class="text-5xl uppercase italic font-bold tracking-wider text-blog-black/90 [letter-spacing:0.02em]"
        >
          Chargement…
        </h3>

        <!-- Artiste -->
        <p
          class="mt-2 text-[15px] tracking-[0.12em] font-bold text-blog-black/90 self-start ml-2"
        >
        </p>

        <!-- Timestamp -->
        <p
          class="mt-4 text-sm italic tracking-wide text-blog-black/90 self-end"
          id="lastmusic_status"
        >
        </p>
      </div>
    </astro-lastmusic>
  </div>
</section>

<script>
    import "./LastMusic.ts";
</script>