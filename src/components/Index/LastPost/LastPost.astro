---
import { getCollection } from 'astro:content';
import {convertDate} from '../../../functions/convertDate.js';
import {cutStr} from '../../../functions/cutStr.js';
const allPosts = await getCollection('posts', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
});

allPosts.sort((a, b) => a.data.publishedDate - b.data.publishedDate);


const lastPost = await allPosts[allPosts.length - 1].render();
const slug = await allPosts[allPosts.length - 1].slug;
const date = new Date(lastPost.remarkPluginFrontmatter.publishedDate);
const day = convertDate(date).daymonth;
const month = convertDate(date).month.substring(0,3) + '.';
const year = convertDate(date).year;
const lastPostTitle = lastPost.remarkPluginFrontmatter.title;
const desc = cutStr(lastPost.remarkPluginFrontmatter.description, 1000);
const img = lastPost.remarkPluginFrontmatter.image;
const bgIMG = `url("${img}")`;

let title 
if(lastPost.remarkPluginFrontmatter && lastPost.remarkPluginFrontmatter.parts){
   title = `${lastPost.remarkPluginFrontmatter.title} [PARTIE  ${lastPost.remarkPluginFrontmatter.part}]`;
}
else 
{
   title = lastPost.remarkPluginFrontmatter.title;
}




---


<div id='LastPost'  class="flex flex-col relative xl:flex-row  mt-32  xl:mt-64 shadow-2xl shadow-[#dba55e1e] xl:rounded-l-2xl xl:rounded-r-lg backdrop-contrast-125">
    <div class="absolute top-0 left-0 w-full h-full bg-blog-black opacity-30 -z-50 bg-gradient-to-b from-zinc-900 via-zinc-800 to-blog-black xl:rounded-l-2xl "/>

    <div class='relative flex flex-col items-start justify-center h-full gap-4 p-8 sm:basis-2/3 sm:px-16'>
        <h1 class='text-2xl sm:text-5xl' transition:name=`post ${slug} title`>{title}</h1>
        <div class="flex flex-col gap-4">
            <p transition:name=`post ${slug} desc`>{desc}</p>
            <p transition:name=`post ${slug} mintoread`>☕ {lastPost.remarkPluginFrontmatter.minutesRead}</p>
        </div>
        <div class='flex flex-col items-center justify-between w-full gap-8 xl:flex-row xl:gap-0 xl:items-end'>
            <a href={"/posts/" + slug} class='w-full xl:w-6/12 ' transition:name=`post ${slug} box`>
                <button class='w-full xl:w-full btn--two-colors--bl-tr'>
                    Lire l'article
                </button>
            </a>
            <div class='relative flex flex-col items-center gap-4 bg-transparent xl:flex-row xl:gap-16 xl:items-end ' transition:name=`post ${slug} tag`>
                <p class='z-10 text-sm'>Tag(s) :</p>
                <ul class="flex-wrap justify-end h-32 pl-4 xl:flex xl:flex-col xl:justify-left xl:gap-4 xl:pl-0"  >
                    {lastPost.remarkPluginFrontmatter.tags.map((tag : string) => (
                        <a href=`/tags/${tag}` class="z-10 mr-4 xl:mr-0">
                            <li class="font-mono transition text-blog-marron-reflet hover:text-blog-marron-text hover-underline-animation "><span class="text-[0.7rem] mr-1">#</span>{tag}</li>
                        </a>
                    ))}
                </ul> 
            </div>
        </div>

    </div>
 <div class="order-first overflow-hidden xl:rounded-r-lg xl:basis-1/3 xl:order-last">
  <img transition:name={`post ${slug} image`} 
       class="object-cover object-center w-full h-64 xl:h-full xl:rounded-r-lg " 
       src={img}  
       alt="Image en rapport avec la news." />
</div>
        <div         transition:name=`post ${slug} date`
        class="absolute right-0 z-50 font-mono font-semibold text-blog-black top-8 xl:-right-16 xl:text-2xl">
            <p class='inline-block px-1 pl-4 bg-blog-marron-fond rounded-bl-3xl rounded-tl-2xl'>{day} {month} {year}</p>
        </div>
    </div>
</div>


