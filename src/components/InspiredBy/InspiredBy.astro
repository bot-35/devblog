---
const { data } = Astro.props;
import { Icon } from 'astro-icon/components'

---

<section class='w-full flex flex-col justify-center items-center content-center mt-64'>
    <Icon pack="ic" name="outline-share" class='h-12 mb-4 inline' />
    <p class='text-center leading-10'>Article inspiré par :<br/><a class='hover-underline-animation text-blog-marron-reflet hover:text-blog-marron-text'  href={data}>{data}</a></p>
</section>