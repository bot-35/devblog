---



import Layout from '../layouts/layout.astro';
import LayoutwithoutMargin from '../layouts/layoutwithoutmargin.astro';
import profil2 from '../img/photo-bg/404.png';


const title = '404';
---
<LayoutwithoutMargin title={title}>
    
    <section class="flex flex-col relative  gap-8 h-full w-full content-center items-center justify-center text-center py-32 overflow-hidden bg-[#0f0f0f]">
        
       <img src={profil2.src} alt="404" class="h-64 xl:h-128"/>
    
        <p class="text-center text-white text-7xl uppercase">On est perdu ?</p>
        <a href="/"><p class='uppercase hover-underline-animation'>Retrouvez votre chemin...</p></a>
        <!--<p class="text-center text-red-500  text-4xl font-mono uppercase mt-8">erreur 404</p>-->
    </section>
</LayoutwithoutMargin>

